      modbusCurAddr: { addr: "417981", encoding: "u4", scale: "*0.1" }
      modbusWriteAddr: { addr: "417981", encoding: "u4", scale: "*0.1" }
    }
    reg16478: ElecAcPhaseQualityCurrentSensor {
      totalHarmonicDistortion
      phase: "L1"
      dis: "Phase A Current THD"
      bacnetCurAddr: { addr: "AI68" }
      modbusCurAddr: { addr: "416479", encoding: "s2", scale: "*0.01" }
    }
    reg16479: ElecAcPhaseQualityCurrentSensor {
      totalHarmonicDistortion
      phase: "L2"
      dis: "Phase B Current THD"
      bacnetCurAddr: { addr: "AI69" }
      modbusCurAddr: { addr: "416480", encoding: "s2", scale: "*0.01" }
    }
    reg16480: ElecAcPhaseQualityCurrentSensor {
      totalHarmonicDistortion
      phase: "L3"
      dis: "Phase C Current THD"
      bacnetCurAddr: { addr: "AI70" }
      modbusCurAddr: { addr: "416481", encoding: "s2", scale: "*0.01" }
    }
    reg16481: ElecAcLAvgQualityCurrentSensor {
      totalHarmonicDistortion
      dis: "Average Current THD"
      bacnetCurAddr: { addr: "AI71" }
      modbusCurAddr: { addr: "416482", encoding: "s2", scale: "*0.01" }
    }




    //////////////////////////////////////////////////////////////////
    // Additional basic metering (part of the predefined 71 BACnet
    // Analog Input objects in Table 6-85 of the user manual)
    //////////////////////////////////////////////////////////////////

    // 76.0=L (inductive), 67.0=C (capacitive), 82.0=R (resistive)
    reg16448: NumberPoint {
      sensor
      dis: "Load Characteristic"
      notHaystack
      bacnetCurAddr: { addr: "AI33" }
      modbusCurAddr: { addr: "416449", encoding: "f4" }
    }
    reg17920: ElecAcPhaseNetCurrentDemandSensor {
      phase: "L1"
      dis: "Phase A Current Demand"
      bacnetCurAddr: { addr: "AI37" }
      modbusCurAddr: { addr: "417921", encoding: "f4" }
    }
    reg17922: ElecAcPhaseNetCurrentDemandSensor {
      phase: "L2"
      dis: "Phase B Current Demand"
      bacnetCurAddr: { addr: "AI38" }
      modbusCurAddr: { addr: "417923", encoding: "f4" }
    }
    reg17924: ElecAcPhaseNetCurrentDemandSensor {
      phase: "L3"
      dis: "Phase C Current Demand"
      bacnetCurAddr: { addr: "AI39" }
      modbusCurAddr: { addr: "417925", encoding: "f4" }
    }

    // Max current demand per phase, plus timestamps (Table 6-34)
    reg17926: NumberPoint {
      sensor
      dis: "Max of Phase A current demand"
      notHaystack
      modbusCurAddr: { addr: "417927", encoding: "s2" }
    }
    reg17927: NumberPoint {
      sensor
      dis: "Max of Phase A current demand Time stamp (Word 1)"
      notHaystack
      modbusCurAddr: { addr: "417928", encoding: "u2" }
    }
