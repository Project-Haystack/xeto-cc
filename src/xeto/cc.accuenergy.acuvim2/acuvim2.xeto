//////////////////////////////////////////////////////////////////////////
// Local Enum Types
//////////////////////////////////////////////////////////////////////////

AcuvimAlarmParameterEnum : Enum {
  freq, va, vb, vc, avgPhaseVoltage, uab,
  ubc, uca, avgLineVoltage, currentA, currentB, currentC,
  avgCurrent, neutralCurrent, powerA, powerB, powerC, powerAll,
  reactivePowerA, reactivePowerB, reactivePowerC, reactivePowerAll, apparentPowerA, apparentPowerB,
  apparentPowerC, apparentPowerAll, pfA, pfB, pfC, pf,
  voltageUnbalance, currentUnbalance, loadCharacteristic, thdV1, thdV2, thdV3,
  avgThdV, thdI1, thdI2, thdI3, avgThdI, ai1SamplingValue,
  ai2SamplingValue, ai3SamplingValue, ai4SamplingValue, activePowerDemandAll, reactivePowerDemandAll, apparentPowerDemandAll,
  currentDemandA, currentDemandB, currentDemandC, reversedPhaseSequence, di1, di2,
  di3, di4, di5, di6, di7, di8,
  di9, di10, di11, di12, di13, di14,
  di15, di16, di17, di18, di19, di20,
  di21, di22, di23, di24, di25, di26,
  di27, di28
}

AcuvimIoModuleEnum : Enum {
  none, axmIo11, axmIo21, axmIo31, axmIo12, axmIo22, axmIo32
}

AcuvimFrequencyEnum : Enum {
  hz50, hz60
}

// Table 6-15 prints "0: Modbus, 2: BACnet MS/TP" for this register, but
// the note on the following page states "When the register 0FFEH is 1,
// the channel 1 communication protocol is set to BACnet" -- trusting
// the note (deliberate clarifying prose) over the table.
AcuvimCommProtocolEnum : Enum {
  modbus, bacnet
}

AcuvimParityEnum : Enum {
  even, odd, non2, non1
}

AcuvimVoltageWiringEnum : Enum {
  threeLN, oneLN, twoLL, threeLL, oneLL
}

AcuvimCurrentWiringEnum : Enum {
  threeCt, oneCt, twoCt
}

AcuvimDemandCalcModeEnum : Enum {
  fixedWindow, slidingWindow, thermal, rollingWindow
}

AcuvimDirectionEnum : Enum {
  positive, negative
}

AcuvimLineNCurrentMethodEnum : Enum {
  calculated, measured
}

AcuvimLoadCharacteristicBasisEnum : Enum {
  current, power
}

AcuvimVarPfConventionEnum : Enum {
  iec, ieee
}

AcuvimEnergyCalcModeEnum : Enum {
  fundamental, fullWave
}

AcuvimReactivePowerModeEnum : Enum {
  real, general
}

AcuvimEnergyDisplayModeEnum : Enum {
  primary, secondary, primaryIn01kWh
}

AcuvimBasicParameterModeEnum : Enum {
  secondary, primary
}

AcuvimEthernetResetEnum : Enum {
  none, reset, loadDefaultAndReset
}

AcuvimDisableEnableEnum : Enum {
  disable, enable
}

AcuvimDstFormatEnum : Enum {
  format1, format2
}

AcuvimLogModeEnum : Enum {
  fifoContinuous, startEndTime, startTimeOnly
}

AcuvimWaveformSampleRateEnum : Enum {
  points64, points128
}

AcuvimSagSwellConditionEnum : Enum {
  disabled, sag, swell
}

AcuvimPhaseSelectionEnum : Enum {
  none, physicalWiringIa, physicalWiringIb, physicalWiringIc, physicalWiringIn
}

AcuvimVoltageSelectionEnum : Enum {
  disable, va, vb, vc, vab, vbc, vca
}

AcuvimRoTypeModeEnum : Enum {
  relay, alarm
}

AcuvimRoControlModeEnum : Enum {
  latch, momentary, manual
}

AcuvimDoModeEnum : Enum {
  energyPulseOutput, alarmingOutput
}

AcuvimDoParameterEnum : Enum {
  none, importActivePower, exportActivePower, importReactivePower, exportReactivePower
}

AcuvimAoAiTypeEnum : Enum {
  range0to20mA, range4to20mA, range0to5V, range1to5V
}

AcuvimAoParameterEnum : Enum {
  freq, va, vb, vc, avgPhaseVoltage, vab,
  vbc, vca, avgLineVoltage, currentA, currentB, currentC,
  avgCurrent, neutralCurrent, powerA, powerB, powerC, powerAll,
  reactivePowerA, reactivePowerB, reactivePowerC, reactivePowerAll, apparentPowerA, apparentPowerB,
  apparentPowerC, apparentPowerAll, pfA, pfB, pfC, pf
}

//////////////////////////////////////////////////////////////////////////
// Main Device Model
//////////////////////////////////////////////////////////////////////////

// Device model for Accuenergy's Acuvim II Series Power Meter
Acuvim2ElecAcMeter : AcElecMeter <abstract> {
  resources: Query {
    PdfFile {
      dis: "Acuvim II Series Power Meter User Manual"
      uri: "https://accucdn.accuenergy.com/wp-content/uploads/Acuvim-II-Power-Meter-User-Manual-1040E1303.pdf"
      version: "3.2.15"
    }
  }
  attrs: Query {
    ManufacturerAttr { val: "Accuenergy" }
    ModelSeriesAttr { val: "Acuvim II" }
    DimensionLengthAttr { val: 96mm }
    DimensionWidthAttr { val: 96mm }
    DimensionHeightAttr { val: 64.3mm }
    MinRatedOperatingTempAttr { val: -25°C }
    MaxRatedOperatingTempAttr { val: 70°C }
  }
  points: {
    reg16384: ElecAcFreqSensor {
      dis: "Frequency"
      bacnetCurAddr: { addr: "AI1" }
      modbusCurAddr: { addr: "416385", encoding: "f4" }
    }
    reg16386: ElecAcPhaseRmsVoltageSensor {
      phase: "L1"
      dis: "Phase 1 Voltage"
      bacnetCurAddr: { addr: "AI2" }
      modbusCurAddr: { addr: "416387", encoding: "f4" }
    }
    reg16388: ElecAcPhaseRmsVoltageSensor {
      phase: "L2"
      dis: "Phase 2 Voltage"
      bacnetCurAddr: { addr: "AI3" }
      modbusCurAddr: { addr: "416389", encoding: "f4" }
    }
    reg16390: ElecAcPhaseRmsVoltageSensor {
      phase: "L3"
      dis: "Phase 3 Voltage"
      bacnetCurAddr: { addr: "AI4" }
      modbusCurAddr: { addr: "416391", encoding: "f4" }
    }
    reg16392: ElecAcLAvgRmsVoltageSensor {
      dis: "Average Phase Voltage"
      bacnetCurAddr: { addr: "AI5" }
      modbusCurAddr: { addr: "416393", encoding: "f4" }
    }
    reg16394: ElecAcPhaseRmsVoltageSensor {
      phase: "L1-L2"
      dis: "Line Voltage 1-2"
      bacnetCurAddr: { addr: "AI6" }
      modbusCurAddr: { addr: "416395", encoding: "f4" }
    }
    reg16396: ElecAcPhaseRmsVoltageSensor {
      phase: "L2-L3"
      dis: "Line Voltage 2-3"
      bacnetCurAddr: { addr: "AI7" }
      modbusCurAddr: { addr: "416397", encoding: "f4" }
    }
    reg16398: ElecAcPhaseRmsVoltageSensor {
      phase: "L3-L1"
      dis: "Line Voltage 3-1"
      bacnetCurAddr: { addr: "AI8" }
      modbusCurAddr: { addr: "416399", encoding: "f4" }
    }
    reg16400: ElecAcLLAvgRmsVoltageSensor {
      dis: "Average Line Voltage"
      bacnetCurAddr: { addr: "AI9" }
      modbusCurAddr: { addr: "416401", encoding: "f4" }
    }
    reg16402: ElecAcPhaseUnsignedRmsCurrentSensor {
      phase: "L1"
      dis: "Total Phase A Current"
      bacnetCurAddr: { addr: "AI10" }
      modbusCurAddr: { addr: "416403", encoding: "f4" }
    }
    reg16404: ElecAcPhaseUnsignedRmsCurrentSensor {
      phase: "L2"
      dis: "Total Phase B Current"
      bacnetCurAddr: { addr: "AI11" }
      modbusCurAddr: { addr: "416405", encoding: "f4" }
    }
    reg16406: ElecAcPhaseUnsignedRmsCurrentSensor {
      phase: "L3"
      dis: "Total Phase C Current"
      bacnetCurAddr: { addr: "AI12" }
      modbusCurAddr: { addr: "416407", encoding: "f4" }
    }
    reg16408: ElecAcLAvgUnsignedRmsCurrentSensor {
      dis: "Average Phase Current"
      bacnetCurAddr: { addr: "AI13" }
      modbusCurAddr: { addr: "416409", encoding: "f4" }
    }
    reg16410: ElecAcNeutralUnsignedRmsCurrentSensor {
      dis: "Neutral Current"
      bacnetCurAddr: { addr: "AI14" }
      modbusCurAddr: { addr: "416411", encoding: "f4" }
    }
    reg16412: ElecAcPhaseNetActivePowerSensor {
      phase: "L1"
      dis: "Phase A Power"
      bacnetCurAddr: { addr: "AI15" }
      modbusCurAddr: { addr: "416413", encoding: "f4", scale: "*0.001" }
    }
    reg16414: ElecAcPhaseNetActivePowerSensor {
      phase: "L2"
      dis: "Phase B Power"
      bacnetCurAddr: { addr: "AI16" }
      modbusCurAddr: { addr: "416415", encoding: "f4", scale: "*0.001" }
    }
    reg16416: ElecAcPhaseNetActivePowerSensor {
      phase: "L3"
      dis: "Phase C Power"
      bacnetCurAddr: { addr: "AI17" }
      modbusCurAddr: { addr: "416417", encoding: "f4", scale: "*0.001" }
    }
    reg16418: ElecAcTotalNetActivePowerSensor {
      dis: "Total System Power"
      bacnetCurAddr: { addr: "AI18" }
      modbusCurAddr: { addr: "416419", encoding: "f4", scale: "*0.001" }
    }
    reg16420: ElecAcPhaseNetReactivePowerSensor {
      phase: "L1"
      dis: "Phase A Reactive Power"
      bacnetCurAddr: { addr: "AI19" }
      modbusCurAddr: { addr: "416421", encoding: "f4", scale: "*0.001" }
    }
    reg16422: ElecAcPhaseNetReactivePowerSensor {
      phase: "L2"
      dis: "Phase B Reactive Power"
      bacnetCurAddr: { addr: "AI20" }
      modbusCurAddr: { addr: "416423", encoding: "f4", scale: "*0.001" }
    }
    reg16424: ElecAcPhaseNetReactivePowerSensor {
      phase: "L3"
      dis: "Phase C Reactive Power"
      bacnetCurAddr: { addr: "AI21" }
      modbusCurAddr: { addr: "416425", encoding: "f4", scale: "*0.001" }
    }
    reg16426: ElecAcTotalNetReactivePowerSensor {
      dis: "Total Reactive Power"
      bacnetCurAddr: { addr: "AI22" }
      modbusCurAddr: { addr: "416427", encoding: "f4", scale: "*0.001" }
    }
    reg16428: ElecAcPhaseNetApparentPowerSensor {
      phase: "L1"
      dis: "Phase A Apparent Power"
      bacnetCurAddr: { addr: "AI23" }
      modbusCurAddr: { addr: "416429", encoding: "f4", scale: "*0.001" }
    }
    reg16430: ElecAcPhaseNetApparentPowerSensor {
      phase: "L2"
      dis: "Phase B Apparent Power"
      bacnetCurAddr: { addr: "AI24" }
      modbusCurAddr: { addr: "416431", encoding: "f4", scale: "*0.001" }
    }
    reg16432: ElecAcPhaseNetApparentPowerSensor {
      phase: "L3"
      dis: "Phase C Apparent Power"
      bacnetCurAddr: { addr: "AI25" }
      modbusCurAddr: { addr: "416433", encoding: "f4", scale: "*0.001" }
    }
    reg16434: ElecAcTotalNetApparentPowerSensor {
      dis: "Total Apparent Power"
      bacnetCurAddr: { addr: "AI26" }
      modbusCurAddr: { addr: "416435", encoding: "f4", scale: "*0.001" }
    }
    reg16436: ElecAcPhasePfSensor {
      pfTrue
      pfIec
      phase: "L1"
      dis: "Phase A Power Factor"
      bacnetCurAddr: { addr: "AI27" }
      modbusCurAddr: { addr: "416437", encoding: "f4" }
    }
    reg16438: ElecAcPhasePfSensor {
      pfTrue
      pfIec
      phase: "L2"
      dis: "Phase B Power Factor"
      bacnetCurAddr: { addr: "AI28" }
      modbusCurAddr: { addr: "416439", encoding: "f4" }
    }
    reg16440: ElecAcPhasePfSensor {
      pfTrue
      pfIec
      phase: "L3"
      dis: "Phase C Power Factor"
      bacnetCurAddr: { addr: "AI29" }
      modbusCurAddr: { addr: "416441", encoding: "f4" }
    }
    reg16442: ElecAcTotalPfSensor {
      pfTrue
      pfIec
      dis: "Total Power Factor"
      bacnetCurAddr: { addr: "AI30" }
      modbusCurAddr: { addr: "416443", encoding: "f4" }
    }
    reg16444: ElecAcLLAvgQualityVoltageSensor {
      imbalance
      dis: "Voltage Unbalance"
      bacnetCurAddr: { addr: "AI31" }
      modbusCurAddr: { addr: "416445", encoding: "f4", scale: "*100" }
    }
    reg16446: ElecAcLAvgQualityCurrentSensor {
      imbalance
      dis: "Current Unbalance"
      bacnetCurAddr: { addr: "AI32" }
      modbusCurAddr: { addr: "416447", encoding: "f4", scale: "*100" }
    }
    reg16450: ElecAcTotalNetActiveDemandSensor {
      dis: "Power Demand"
      bacnetCurAddr: { addr: "AI34" }
      modbusCurAddr: { addr: "416451", encoding: "f4", scale: "*0.001" }
    }
    reg16452: ElecAcTotalNetReactiveDemandSensor {
      dis: "Reactive Power Demand"
      bacnetCurAddr: { addr: "AI35" }
      modbusCurAddr: { addr: "416453", encoding: "f4", scale: "*0.001" }
    }
    reg16454: ElecAcTotalNetApparentDemandSensor {
      dis: "Apparent Power Demand"
      bacnetCurAddr: { addr: "AI36" }
      modbusCurAddr: { addr: "416455", encoding: "f4", scale: "*0.001" }
    }
    reg16456: ElecAcTotalImportActiveEnergySensor {
      dis: "Import Active Energy"
      bacnetCurAddr: { addr: "AI40" }
      modbusCurAddr: { addr: "416457", encoding: "u4", scale: "*0.1" }
      modbusWriteAddr: { addr: "416457", encoding: "u4", scale: "*0.1" }
    }
    reg16458: ElecAcTotalExportActiveEnergySensor {
      dis: "Export Active Energy"
      bacnetCurAddr: { addr: "AI41" }
      modbusCurAddr: { addr: "416459", encoding: "u4", scale: "*0.1" }
      modbusWriteAddr: { addr: "416459", encoding: "u4", scale: "*0.1" }
    }
    // Vendor spells "Reactice" (not "Reactive") for this one entry in
