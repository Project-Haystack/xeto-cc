    // Data Log 2 Setting (Table 6-58)
    //////////////////////////////////////////////////////////////////

    // Low byte: Sectors (0~100, 64kb each; 0=disabled). High byte:
    // Registers (0~117, number of registers logged per record).
    reg4544: NumberPoint {
      sp
