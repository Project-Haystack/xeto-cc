    //////////////////////////////////////////////////////////////////
    // Alarm Settings (Table 6-54)
    //////////////////////////////////////////////////////////////////

    reg4166: EnumPoint {
      sp
      dis: "Enable All Alarm Function"
      notHaystack
      enum: Obj <val:AcuvimDisableEnableEnum>
      modbusCurAddr: { addr: "404167", encoding: "u2" }
      modbusWriteAddr: { addr: "404167", encoding: "u2" }
    }
    reg4167: EnumPoint {
      sp
      dis: "Enable Alarm LCD Flashing"
      notHaystack
      enum: Obj <val:AcuvimDisableEnableEnum>
      modbusCurAddr: { addr: "404168", encoding: "u2" }
      modbusWriteAddr: { addr: "404168", encoding: "u2" }
    }
    // Bitmask: Bit0=Channel 1 ... Bit15=Channel 16, 1=Enable, 0=Disable
    reg4168: NumberPoint {
      sp
      dis: "Enable Alarm channels"
      notHaystack
      modbusCurAddr: { addr: "404169", encoding: "u2" }
      modbusWriteAddr: { addr: "404169", encoding: "u2" }
    }
    // Bitmask: Bit0=logic switch between Channel 1 and 2, Bit1=Channel 3
    // and 4, ... Bit7=Channel 15 and 16. 1=Enable, 0=Disable
    reg4169: NumberPoint {
      sp
      dis: "Enable \"And\" logic between alarm channels"
      notHaystack
      modbusCurAddr: { addr: "404170", encoding: "u2" }
      modbusWriteAddr: { addr: "404170", encoding: "u2" }
    }
    // Bitmask: Bit0=Channel 1 ... Bit15=Channel 16, 1=Enable, 0=Disable
    reg4170: NumberPoint {
      sp
      dis: "Alarm channels to trigger DO1"
      notHaystack
      modbusCurAddr: { addr: "404171", encoding: "u2" }
      modbusWriteAddr: { addr: "404171", encoding: "u2" }
    }
    // Bitmask: Bit0=Channel 1 ... Bit15=Channel 16, 1=Enable, 0=Disable
    reg4171: NumberPoint {
      sp
      dis: "Alarm channels to trigger DO2"
      notHaystack
      modbusCurAddr: { addr: "404172", encoding: "u2" }
      modbusWriteAddr: { addr: "404172", encoding: "u2" }
    }
    // Bitmask: Bit0=Channel 1 ... Bit15=Channel 16, 1=Enable, 0=Disable
    reg4172: NumberPoint {
      sp
      dis: "Alarm channels to trigger DO3"
      notHaystack
      modbusCurAddr: { addr: "404173", encoding: "u2" }
      modbusWriteAddr: { addr: "404173", encoding: "u2" }
    }
    // Bitmask: Bit0=Channel 1 ... Bit15=Channel 16, 1=Enable, 0=Disable
    reg4173: NumberPoint {
      sp
      dis: "Alarm channels to trigger DO4"
      notHaystack
      modbusCurAddr: { addr: "404174", encoding: "u2" }
      modbusWriteAddr: { addr: "404174", encoding: "u2" }
    }

    //////////////////////////////////////////////////////////////////
    // Single Channel Alarm Settings (Table 6-55) -- 16 channels, 5
    // registers each. Comparison Mode is 1=Greater than, 2=Equal to,
    // 3=Less than (not zero-based, so modeled as a raw register rather
    // than an Enum). Setpoint's range/scale depends on the selected
    // parameter, so it is exposed raw, matching Alarm Log's Over/Under
    // Limit Value.
    //////////////////////////////////////////////////////////////////

    reg4174: EnumPoint {
      sp
      dis: "Channel 1: Parameter Selection"
      notHaystack
      enum: Obj <val:AcuvimAlarmParameterEnum>
      modbusCurAddr: { addr: "404175", encoding: "u2" }
      modbusWriteAddr: { addr: "404175", encoding: "u2" }
    }
    // 1: Greater than, 2: Equal to, 3: Less than
    reg4175: NumberPoint {
      sp
      dis: "Channel 1: Comparison Mode"
      notHaystack
      modbusCurAddr: { addr: "404176", encoding: "u2" }
      modbusWriteAddr: { addr: "404176", encoding: "u2" }
    }
    reg4176: NumberPoint {
      sp
      dis: "Channel 1: Setpoint (Threshold) Value"
      notHaystack
      modbusCurAddr: { addr: "404177", encoding: "s2" }
      modbusWriteAddr: { addr: "404177", encoding: "s2" }
    }
    reg4177: NumberPoint {
      sp
      dis: "Channel 1: Delay"
      notHaystack
