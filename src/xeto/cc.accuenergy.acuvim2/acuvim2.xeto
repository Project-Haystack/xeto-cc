      modbusCurAddr: { addr: "417973", encoding: "u4", scale: "*0.1" }
      modbusWriteAddr: { addr: "417973", encoding: "u4", scale: "*0.1" }
    }
    reg17974: ElecAcPhaseExportReactiveEnergySensor {
