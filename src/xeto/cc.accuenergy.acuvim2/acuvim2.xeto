      dis: "Phase C Export Reactive Energy"
      bacnetCurAddr: { addr: "AI60" }
      modbusCurAddr: { addr: "417975", encoding: "u4", scale: "*0.1" }
      modbusWriteAddr: { addr: "417975", encoding: "u4", scale: "*0.1" }
    }
    reg17976: ElecAcPhaseNetApparentEnergySensor {
      phase: "L1"
      dis: "Phase A Apparent Energy"
      bacnetCurAddr: { addr: "AI61" }
      modbusCurAddr: { addr: "417977", encoding: "u4", scale: "*0.1" }
      modbusWriteAddr: { addr: "417977", encoding: "u4", scale: "*0.1" }
    }
    reg17978: ElecAcPhaseNetApparentEnergySensor {
      phase: "L2"
      dis: "Phase B Apparent Energy"
      bacnetCurAddr: { addr: "AI62" }
      modbusCurAddr: { addr: "417979", encoding: "u4", scale: "*0.1" }
      modbusWriteAddr: { addr: "417979", encoding: "u4", scale: "*0.1" }
    }
    reg17980: ElecAcPhaseNetApparentEnergySensor {
