    //////////////////////////////////////////////////////////////////
    // System status (Table 6-16)
    //////////////////////////////////////////////////////////////////

    reg4148: NumberPoint {
      sensor
      dis: "Run Time"
      notHaystack
      unit: Unit "hr"
      modbusCurAddr: { addr: "404149", encoding: "u4", scale: "*0.01" }
    }
    // Group number (1-16) of the most recent alarm record, or 0 if none
    reg4146: NumberPoint {
      sensor
      dis: "Alarm Record Number"
      notHaystack
      modbusCurAddr: { addr: "404147", encoding: "u2" }
    }
    // Group number (1-20) of the most recent SOE record, or 0 if none
    reg4147: NumberPoint {
      sensor
      dis: "SOE Record Number"
      notHaystack
      modbusCurAddr: { addr: "404148", encoding: "u2" }
    }
    // Bitmask: bit0=AXM-IO11, bit1=AXM-IO12, bit2=AXM-IO21, bit3=AXM-IO22,
    // bit4=AXM-IO31, bit5=AXM-IO32 (1=connected)
    reg4150: NumberPoint {
      sensor
      dis: "Modules Connection Status"
      notHaystack
      modbusCurAddr: { addr: "404151", encoding: "u2" }
    }


