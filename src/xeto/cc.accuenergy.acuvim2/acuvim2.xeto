    reg16460: ElecAcTotalImportReactiveEnergySensor {
      dis: "Import Reactice Energy"
      bacnetCurAddr: { addr: "AI42" }
      modbusCurAddr: { addr: "416461", encoding: "u4", scale: "*0.1" }
      modbusWriteAddr: { addr: "416461", encoding: "u4", scale: "*0.1" }
    }
    reg16462: ElecAcTotalExportReactiveEnergySensor {
      dis: "Export Reactive Energy"
      bacnetCurAddr: { addr: "AI43" }
      modbusCurAddr: { addr: "416463", encoding: "u4", scale: "*0.1" }
      modbusWriteAddr: { addr: "416463", encoding: "u4", scale: "*0.1" }
    }
    reg16466: ElecAcTotalNetActiveEnergySensor {
      dis: "Net Active Energy"
      bacnetCurAddr: { addr: "AI45" }
      modbusCurAddr: { addr: "416467", encoding: "s4", scale: "*0.1" }
      modbusWriteAddr: { addr: "416467", encoding: "s4", scale: "*0.1" }
    }
    reg16470: ElecAcTotalNetReactiveEnergySensor {
      dis: "Net Reactive Energy"
      bacnetCurAddr: { addr: "AI47" }
      modbusCurAddr: { addr: "416471", encoding: "s4", scale: "*0.1" }
      modbusWriteAddr: { addr: "416471", encoding: "s4", scale: "*0.1" }
    }
    reg16472: ElecAcTotalNetApparentEnergySensor {
      dis: "Apparent Energy"
      bacnetCurAddr: { addr: "AI48" }
      modbusCurAddr: { addr: "416473", encoding: "u4", scale: "*0.1" }
      modbusWriteAddr: { addr: "416473", encoding: "u4", scale: "*0.1" }
    }
    reg17952: ElecAcPhaseImportActiveEnergySensor {
      phase: "L1"
      dis: "Phase A Import Active Energy"
      bacnetCurAddr: { addr: "AI49" }
      modbusCurAddr: { addr: "417953", encoding: "u4", scale: "*0.1" }
      modbusWriteAddr: { addr: "417953", encoding: "u4", scale: "*0.1" }
    }
    reg17954: ElecAcPhaseExportActiveEnergySensor {
      phase: "L1"
      dis: "Phase A Export Active Energy"
      bacnetCurAddr: { addr: "AI50" }
      modbusCurAddr: { addr: "417955", encoding: "u4", scale: "*0.1" }
      modbusWriteAddr: { addr: "417955", encoding: "u4", scale: "*0.1" }
    }
    reg17956: ElecAcPhaseImportActiveEnergySensor {
      phase: "L2"
      dis: "Phase B Import Active Energy"
      bacnetCurAddr: { addr: "AI51" }
      modbusCurAddr: { addr: "417957", encoding: "u4", scale: "*0.1" }
      modbusWriteAddr: { addr: "417957", encoding: "u4", scale: "*0.1" }
    }
    reg17958: ElecAcPhaseExportActiveEnergySensor {
      phase: "L2"
      dis: "Phase B Export Active Energy"
      bacnetCurAddr: { addr: "AI52" }
      modbusCurAddr: { addr: "417959", encoding: "u4", scale: "*0.1" }
      modbusWriteAddr: { addr: "417959", encoding: "u4", scale: "*0.1" }
    }
    reg17960: ElecAcPhaseImportActiveEnergySensor {
      phase: "L3"
      dis: "Phase C Import Active Energy"
      bacnetCurAddr: { addr: "AI53" }
      modbusCurAddr: { addr: "417961", encoding: "u4", scale: "*0.1" }
      modbusWriteAddr: { addr: "417961", encoding: "u4", scale: "*0.1" }
    }
    reg17962: ElecAcPhaseExportActiveEnergySensor {
