      modbusCurAddr: { addr: "436174", encoding: "u2" }
    }
    // Voltage sag: 20-100%. Voltage swell: 50-140%
    reg36174: NumberPoint {
      sensor
      dis: "No. 10 Event: Set Threshold"
      notHaystack
      unit: Unit "%"
      modbusCurAddr: { addr: "436175", encoding: "u2" }
    }
    // Voltage sag event: 4~200 half cycles. Voltage swell event: 0
    reg36175: NumberPoint {
      sensor
      dis: "No. 10 Event: Half cycle count"
      notHaystack
      modbusCurAddr: { addr: "436176", encoding: "u2" }
    }

    //////////////////////////////////////////////////////////////////
    // Phase Selection (Table 6-80)
    //////////////////////////////////////////////////////////////////

    reg4340: EnumPoint {
      sp
      dis: "Ia channel phase selection"
      notHaystack
      enum: Obj <val:AcuvimPhaseSelectionEnum>
      modbusCurAddr: { addr: "404341", encoding: "u2" }
      modbusWriteAddr: { addr: "404341", encoding: "u2" }
    }
    reg4341: EnumPoint {
      sp
      dis: "Ib channel phase selection"
      notHaystack
      enum: Obj <val:AcuvimPhaseSelectionEnum>
      modbusCurAddr: { addr: "404342", encoding: "u2" }
      modbusWriteAddr: { addr: "404342", encoding: "u2" }
    }
    reg4342: EnumPoint {
      sp
      dis: "Ic channel phase selection"
      notHaystack
      enum: Obj <val:AcuvimPhaseSelectionEnum>
      modbusCurAddr: { addr: "404343", encoding: "u2" }
      modbusWriteAddr: { addr: "404343", encoding: "u2" }
    }
    reg4343: EnumPoint {
      sp
      dis: "In channel phase selection"
      notHaystack
      enum: Obj <val:AcuvimPhaseSelectionEnum>
      modbusCurAddr: { addr: "404344", encoding: "u2" }
      modbusWriteAddr: { addr: "404344", encoding: "u2" }
    }

    //////////////////////////////////////////////////////////////////
    // Independent Input Channel Settings (Table 6-81). Input Channel
    // 4 CT1 shares the same register as CT41 (System Status
    // Parameters, Table 6-16), so it is not duplicated here.
    //////////////////////////////////////////////////////////////////

    reg5167: EnumPoint {
      sp
      dis: "Enable Independent Input Channel"
      notHaystack
      enum: Obj <val:AcuvimDisableEnableEnum>
      modbusCurAddr: { addr: "405168", encoding: "u2" }
      modbusWriteAddr: { addr: "405168", encoding: "u2" }
    }
    reg5168: NumberPoint {
      sp
      dis: "Input Channel 1 CT1"
      notHaystack
      modbusCurAddr: { addr: "405169", encoding: "u2" }
      modbusWriteAddr: { addr: "405169", encoding: "u2" }
    }
    reg5169: NumberPoint {
      sp
      dis: "Input Channel 2 CT1"
      notHaystack
      modbusCurAddr: { addr: "405170", encoding: "u2" }
      modbusWriteAddr: { addr: "405170", encoding: "u2" }
    }
    reg5170: NumberPoint {
      sp
      dis: "Input Channel 3 CT1"
      notHaystack
      modbusCurAddr: { addr: "405171", encoding: "u2" }
      modbusWriteAddr: { addr: "405171", encoding: "u2" }
    }
    reg5171: EnumPoint {
      sp
      dis: "Voltage Selection for Input Channel 1"
      notHaystack
      enum: Obj <val:AcuvimVoltageSelectionEnum>
      modbusCurAddr: { addr: "405172", encoding: "u2" }
      modbusWriteAddr: { addr: "405172", encoding: "u2" }
    }
    reg5172: EnumPoint {
      sp
      dis: "Voltage Selection for Input Channel 2"
      notHaystack
      enum: Obj <val:AcuvimVoltageSelectionEnum>
      modbusCurAddr: { addr: "405173", encoding: "u2" }
      modbusWriteAddr: { addr: "405173", encoding: "u2" }
    }
    reg5173: EnumPoint {
      sp
      dis: "Voltage Selection for Input Channel 3"
      notHaystack
      enum: Obj <val:AcuvimVoltageSelectionEnum>
      modbusCurAddr: { addr: "405174", encoding: "u2" }
      modbusWriteAddr: { addr: "405174", encoding: "u2" }
    }
    reg5174: EnumPoint {
      sp
      dis: "Voltage Selection for Input Channel 4"
      notHaystack
      enum: Obj <val:AcuvimVoltageSelectionEnum>
      modbusCurAddr: { addr: "405175", encoding: "u2" }
      modbusWriteAddr: { addr: "405175", encoding: "u2" }
    }
    // Bitmask: Bit0=Input Channel 1, Bit1=Input Channel 2, Bit2=Input
    // Channel 3, Bit3=Input Channel 4. 1=Selected, 0=Not Selected
    reg5175: NumberPoint {
      sp
      dis: "Summation Channel 1 Configuration"
      notHaystack
      modbusCurAddr: { addr: "405176", encoding: "u2" }
      modbusWriteAddr: { addr: "405176", encoding: "u2" }
    }
    // Bitmask: Bit0=Input Channel 1, Bit1=Input Channel 2, Bit2=Input
    // Channel 3, Bit3=Input Channel 4. 1=Selected, 0=Not Selected
    reg5176: NumberPoint {
      sp
      dis: "Summation Channel 2 Configuration"
      notHaystack
      modbusCurAddr: { addr: "405177", encoding: "u2" }
      modbusWriteAddr: { addr: "405177", encoding: "u2" }
    }
  }
}
