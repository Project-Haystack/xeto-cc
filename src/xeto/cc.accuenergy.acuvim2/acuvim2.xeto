    //////////////////////////////////////////////////////////////////
    // Waveform Record Parameter Setting (Table 6-77). Acuvim IIW-only
    // feature (waveform capture / power quality event logging).
    //////////////////////////////////////////////////////////////////

    // 0xAA (170): Enable, 0: Disable
    reg32768: NumberPoint {
      sp
      dis: "Manual Trigger"
      notHaystack
      modbusCurAddr: { addr: "432769", encoding: "u2" }
      modbusWriteAddr: { addr: "432769", encoding: "u2" }
    }
    // Bitfield, 2 bits per DI channel: 00=Disable, 01=From OFF to ON,
    // 10=From ON to OFF, 11=Any DI state change
    reg32769: NumberPoint {
      sp
      dis: "DI Trigger - AXM-IO11"
      notHaystack
      modbusCurAddr: { addr: "432770", encoding: "u2" }
      modbusWriteAddr: { addr: "432770", encoding: "u2" }
    }
    // Bitfield, 2 bits per DI channel: 00=Disable, 01=From OFF to ON,
    // 10=From ON to OFF, 11=Any DI state change
    reg32770: NumberPoint {
      sp
      dis: "DI Trigger - AXM-IO21"
      notHaystack
      modbusCurAddr: { addr: "432771", encoding: "u2" }
      modbusWriteAddr: { addr: "432771", encoding: "u2" }
    }
    // Bitfield, 2 bits per DI channel: 00=Disable, 01=From OFF to ON,
    // 10=From ON to OFF, 11=Any DI state change
    reg32771: NumberPoint {
      sp
      dis: "DI Trigger - AXM-IO31"
      notHaystack
      modbusCurAddr: { addr: "432772", encoding: "u2" }
      modbusWriteAddr: { addr: "432772", encoding: "u2" }
    }
    // LN wiring: 50V-400V. LL wiring: 50V-690V
    reg32772: NumberPoint {
      sp
      dis: "Voltage rated value"
      notHaystack
      unit: Unit "V"
      modbusCurAddr: { addr: "432773", encoding: "u2" }
      modbusWriteAddr: { addr: "432773", encoding: "u2" }
    }
    reg32773: EnumPoint {
      sp
      dis: "Voltage sag trigger"
      notHaystack
      enum: Obj <val:AcuvimDisableEnableEnum>
      modbusCurAddr: { addr: "432774", encoding: "u2" }
      modbusWriteAddr: { addr: "432774", encoding: "u2" }
    }
    reg32774: NumberPoint {
      sp
      dis: "Voltage sag threshold"
      notHaystack
      unit: Unit "%"
      modbusCurAddr: { addr: "432775", encoding: "u2" }
      modbusWriteAddr: { addr: "432775", encoding: "u2" }
    }
    // Range: 4-200 half cycles
    reg32775: NumberPoint {
      sp
      dis: "Voltage sag half cycle threshold"
      notHaystack
      modbusCurAddr: { addr: "432776", encoding: "u2" }
      modbusWriteAddr: { addr: "432776", encoding: "u2" }
    }
    reg32776: EnumPoint {
      sp
      dis: "Voltage swell trigger"
      notHaystack
      enum: Obj <val:AcuvimDisableEnableEnum>
      modbusCurAddr: { addr: "432777", encoding: "u2" }
      modbusWriteAddr: { addr: "432777", encoding: "u2" }
    }
    reg32777: NumberPoint {
      sp
      dis: "Voltage swell threshold"
      notHaystack
      unit: Unit "%"
      modbusCurAddr: { addr: "432778", encoding: "u2" }
      modbusWriteAddr: { addr: "432778", encoding: "u2" }
    }
    reg32778: EnumPoint {
      sp
      dis: "Sample Rate"
      notHaystack
      enum: Obj <val:AcuvimWaveformSampleRateEnum>
      modbusCurAddr: { addr: "432779", encoding: "u2" }
      modbusWriteAddr: { addr: "432779", encoding: "u2" }
    }
    // 5A meter type: 0.5-5.0 A. Other meter types: 0.5-1.2 A
    reg32779: NumberPoint {
      sp
      dis: "Current rated value"
      notHaystack
      unit: Unit "A"
      modbusCurAddr: { addr: "432780", encoding: "u2", scale: "*0.001" }
      modbusWriteAddr: { addr: "432780", encoding: "u2", scale: "*0.001" }
    }
    reg32780: EnumPoint {
      sp
      dis: "Over-current triggering waveform"
      notHaystack
      enum: Obj <val:AcuvimDisableEnableEnum>
      modbusCurAddr: { addr: "432781", encoding: "u2" }
      modbusWriteAddr: { addr: "432781", encoding: "u2" }
    }
    reg32781: NumberPoint {
      sp
      dis: "Over-current threshold"
      notHaystack
      unit: Unit "%"
      modbusCurAddr: { addr: "432782", encoding: "u2" }
      modbusWriteAddr: { addr: "432782", encoding: "u2" }
    }
    // 0x55 (85): Enable/trigger
    reg32782: NumberPoint {
      sp
      dis: "Clear waveform"
      notHaystack
      modbusCurAddr: { addr: "432783", encoding: "u2" }
      modbusWriteAddr: { addr: "432783", encoding: "u2" }
    }
    // 0x55 (85): Enable/trigger
    reg32783: NumberPoint {
      sp
      dis: "Clear power quality event"
      notHaystack
      modbusCurAddr: { addr: "432784", encoding: "u2" }
      modbusWriteAddr: { addr: "432784", encoding: "u2" }
    }

    //////////////////////////////////////////////////////////////////
    // Waveform Capture Data Retrieve Address (Table 6-78). Paging
    // mechanism: write group/data number, poll window status, then
    // read the window. Real value (V) = raw / 37.59105; real value
    // (A) varies by CT type -- see Chapter 6.3.20 of the manual.
    //////////////////////////////////////////////////////////////////

    // 128-point recording: 1~100. 64-point recording: 1~200
    reg36608: NumberPoint {
      sp
      dis: "Waveform group number for retrieving"
      notHaystack
      modbusCurAddr: { addr: "436609", encoding: "u2" }
      modbusWriteAddr: { addr: "436609", encoding: "u2" }
    }
    // 128-point recording: 1~241. 64-point recording: 1~121
    reg36609: NumberPoint {
      sp
      dis: "Data number of each record"
      notHaystack
      modbusCurAddr: { addr: "436610", encoding: "u2" }
      modbusWriteAddr: { addr: "436610", encoding: "u2" }
    }
    // 0x0B: Window data is valid, 0xFF: Window data is invalid,
    // 0xAA: Waveform record memory is currently undergoing clearing
    // (data is invalid)
    reg36610: NumberPoint {
      sp
      dis: "Waveform record window status"
      notHaystack
      modbusCurAddr: { addr: "436611", encoding: "u2" }
      modbusWriteAddr: { addr: "436611", encoding: "u2" }
    }
    // 128-point recording: 1~100. 64-point recording: 1~200
    reg36611: NumberPoint {
      sp
      dis: "Latest waveform group number"
