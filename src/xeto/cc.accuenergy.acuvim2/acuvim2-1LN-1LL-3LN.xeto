// Device model for Accuenergy's Acuvim II Series Power Meter (1LN, 1LL, 3LN, or 3LN-2.5 wiring)
Acuvim2ElecAc1LNOr1LLOr3LNMeter : Acuvim2ElecAcMeter <abstract> {
  points: {
    reg16474: ElecAcPhaseQualityVoltageSensor? {
      totalHarmonicDistortion
      phase: "L1"
      dis: "THD_V1"
      bacnetCurAddr: { addr: "AI64" }
      modbusCurAddr: { addr: "416475", encoding: "s2", scale: "*0.01" }
    }
    reg16475: ElecAcPhaseQualityVoltageSensor? {
      totalHarmonicDistortion
      phase: "L2"
      dis: "THD_V2"
      bacnetCurAddr: { addr: "AI65" }
      modbusCurAddr: { addr: "416476", encoding: "s2", scale: "*0.01" }
    }
    reg16476: ElecAcPhaseQualityVoltageSensor? {
      totalHarmonicDistortion
      phase: "L3"
      dis: "THD_V3"
      bacnetCurAddr: { addr: "AI66" }
      modbusCurAddr: { addr: "416477", encoding: "s2", scale: "*0.01" }
    }
    reg16477: ElecAcLAvgQualityVoltageSensor? {
      totalHarmonicDistortion
      dis: "THD_avg"
      bacnetCurAddr: { addr: "AI67" }
      modbusCurAddr: { addr: "416478", encoding: "s2", scale: "*0.01" }
    }

    //////////////////////////////////////////////////////////////////
    // Individual harmonics, 2nd-63rd order, plus odd/even total
    // harmonic distortion, crest factor, and THFF (Tables 6-28
    // through 6-30)
    //////////////////////////////////////////////////////////////////

    reg16482: ElecAcPhaseQualityVoltageSensor? {
