    // BACnet configuration is allowed in the Device Configuration Source
    // variable: false (metric), true (imperial)
    bo2 : BoolPoint? <notHaystack> {
      sp
      dis: "Units"
      bacnetCurAddr: { addr: "BO2" }
      bacnetWriteAddr: { addr: "BO2" }
      modbusCurAddr: { addr: "000123", encoding: "bit" }
      modbusWriteAddr: { addr: "000123", encoding: "bit", access: "w" }
    }
    // Device's up time
    ai0 : NumberPoint? <notHaystack> {
      sensor
      dis: "UpTime"
      unit: Unit "sec"
      bacnetCurAddr: { addr: "AI0" }
      modbusCurAddr: { addr: "300001", encoding: "u2" }
    }
    // Current application version
    ai100 : NumberPoint? <notHaystack> {
      sensor
      dis: "AppVersion"
      bacnetCurAddr: { addr: "AI100" }
      modbusCurAddr: { addr: "300103", encoding: "u2" }
    }

    // TriacOutputsConfig (TO1-TO4) and List of I/Os (section 4.1.7) are
    // low-level hardware terminal/wiring references, not application
    // control points -- excluded per Playbook Step 2.2, documented here
    // rather than silently dropped. TO1-TO4 use BACnet ID/Modbus values
    // 996-999 with no unit, no description, and "Exposed on BACnet/Modbus"
    // marked False in the source table.
  }
}

