//////////////////////////////////////////////////////////////////////////
// Local Enum Types
//////////////////////////////////////////////////////////////////////////

OccupancyStatusEnum : Enum { occupied, unoccupied, bypass, standby }
OccupancyModeEnum : Enum { occupied, unoccupied, bypass, standby }
PanelOccupancyStatusEnum : Enum { unoccupied, occupied, standby, bypass }
TempSensorTypeEnum : Enum {
  voltage, current, resistance, ntc10k3a1, ntc10k4a1, ntc10kCarel,
  ntc20k6a1, ntc2_2k3a1, ntc3k3a1, ntc30k6a1, sie1, tac1, sat1, pt1000,
  ni1000, ni1000_21c, ni1000LgF, ntc10kType2F, ntc10kType3F, ntc20kF,
  ntc3kF, pt1000F, ni1000_32F, ni1000_70F
}
TemperatureInputSelectorEnum : Enum { panel, input, network }
SetpointOffsetSelectorEnum : Enum { panel, input, network }
Co2InputSelectorEnum : Enum { panel, input, network }
HvacModeEnum : Enum {
  auto, heat, morningWarmUp, cool, nightPurge, preCool, off, fire
}
HvacStatusEnum : Enum {
  occupiedCooling, occupiedHeating, standbyCooling, standbyHeating,
  unoccupiedCooling, unoccupiedHeating, off, fire
}
DamperCommandModeEnum : Enum {
  auto, maxFlow, minFlow, userFlow, userPosition, fullOpen, fullClose,
  calibrate
}
FanCommandModeEnum : Enum { auto, maxSpeed, minSpeed, stop }
ReheaterCommandModeEnum : Enum { auto, fullOpen, fullClose }
HeaterPriorityEnum : Enum { reheater, perimeter, simultaneous }
ReheaterStatusEnum : Enum { off, stage1, stage2 }
PerimeterCommandModeEnum : Enum { auto, fullOpen, fullClose }
PerimeterTypeEnum : Enum { none, timeProp, digital }
ReheaterTypeEnum : Enum { none, timeProp, staged, float }
FanTypeEnum : Enum { none, series, parallel }
PanelFanStatusEnum : Enum { off, speed1, speed2, speed3 }

//////////////////////////////////////////////////////////////////////////
// Main Device Model
//////////////////////////////////////////////////////////////////////////

// iSMA Controlli VAV14-IP -- BACnet/IP terminal unit controller for VAV
// applications, part of the nano EDGE ENGINE series.
//
// Source documentation:
//   VAV14-IP Software User Manual (DMP305en, 1st Issue rev. 4, 06/2026)
//   Section 4.1.6 "List of Variables in Application" -- 116 licensed
//   Data Points, https://support.ismacontrolli.com/ (see RESEARCH.md)
//
//   nano EDGE ENGINE series BACnet PICS (2026-04-15, firmware 1.10,
//   BACnet Protocol Revision 19, B-ASC device profile)
//
// Scope: this model covers application-level BACnet-exposed Data Points
// as documented in section 4.1.6.  Points that map to an existing ph spec
// use it directly; points with no ph equivalent are modeled with generic
// point shapes and the `notHaystack` marker.  Point doc comments are
// transcribed verbatim from the manual's "BACnet Objects/Modbus
// Registers" quick start-up table (section 4.1.5).  Four low-level
// TriacOutputsConfig points (TO1-TO4) and I/O wiring assignments (section
// 4.1.7) are hardware terminal references, not control points, and are
// excluded -- see RESEARCH.md for the full accounting.
IsmaVav14 : Vav {

  attrs: Query {
    ManufacturerAttr { val: "iSMA Controlli" }
    ModelSeriesAttr { val: "VAV14-IP" }
  }

  resources: List? <of:File> {
    PdfFile {
      dis: "VAV14-IP Software User Manual"
      uri: "https://support.ismacontrolli.com/04%20Comfort%20Management/VAV14-IP/Manuals/VAV14-IP_Software_Manual_DMP305en_V1.4.0.pdf"
    }
  }

  points: {

    //////////////////////////////////////////////////////////////////
    // OccupancyCalculator
    //////////////////////////////////////////////////////////////////

    // Current occupancy status
    msi2 : EnumPoint? <notHaystack> {
      sensor
      dis: "OccupancyStatus"
      enum: Obj <val:OccupancyStatusEnum>
      bacnetCurAddr: { addr: "MSI2" }
      modbusCurAddr: { addr: "300023", encoding: "u2" }
    }
    // Allows to set room the occupancy mode from the BMS system
    msv2 : EnumPoint? <notHaystack> {
      sp
      dis: "OccupancyMode"
      enum: Obj <val:OccupancyModeEnum>
      bacnetCurAddr: { addr: "MSV2" }
      bacnetWriteAddr: { addr: "MSV2" }
      modbusCurAddr: { addr: "400263", encoding: "u2" }
      modbusWriteAddr: { addr: "400263", encoding: "u2", access: "w" }
    }
    // Current room occupancy status dedicated to Control Point room panel
    msv3 : EnumPoint? <notHaystack> {
      sensor
      dis: "PanelOccupancyStatus"
      enum: Obj <val:PanelOccupancyStatusEnum>
      bacnetCurAddr: { addr: "MSV3" }
      bacnetWriteAddr: { addr: "MSV3" }
      modbusCurAddr: { addr: "400701", encoding: "u2" }
      modbusWriteAddr: { addr: "400701", encoding: "u2", access: "w" }
    }
    // Status of set room occupancy mode from Control Point room panel
    msv4 : EnumPoint? <notHaystack> {
      sp
      dis: "PanelOccupancyMode"
      enum: Obj <val:OccupiedEnum>
      bacnetCurAddr: { addr: "MSV4" }
      bacnetWriteAddr: { addr: "MSV4" }
      modbusCurAddr: { addr: "400702", encoding: "u2" }
      modbusWriteAddr: { addr: "400702", encoding: "u2", access: "w" }
    }
    // Actual presence sensor state from the I1 input
    bi0 : ZoneOccupiedSensor? {
      dis: "PresenceSensor"
      bacnetCurAddr: { addr: "BI0" }
      modbusCurAddr: { addr: "100302", encoding: "bit" }
    }
    // Actual window contact state from the I2 input
    bi1 : BoolPoint? <notHaystack> {
      sensor
      dis: "WindowContact"
      bacnetCurAddr: { addr: "BI1" }
      modbusCurAddr: { addr: "100304", encoding: "bit" }
    }
    // Time required to maintain the bypass occupancy status (after
    // expiration it returns to the previous status)
    av34 : NumberPoint? <notHaystack> {
      sp
      dis: "BypassTimeOverride"
      unit: Unit "min"
      bacnetCurAddr: { addr: "AV34" }
      bacnetWriteAddr: { addr: "AV34" }
      modbusCurAddr: { addr: "400235", encoding: "u2" }
      modbusWriteAddr: { addr: "400235", encoding: "u2", access: "w" }
    }

    // Time required to change the occupancy status to standby (after
    // motion detection disappears)
    av35 : NumberPoint? <notHaystack> {
      sp
      dis: "StandbyTimeOverride"
      unit: Unit "min"
      bacnetCurAddr: { addr: "AV35" }
      bacnetWriteAddr: { addr: "AV35" }
      modbusCurAddr: { addr: "400236", encoding: "u2" }
      modbusWriteAddr: { addr: "400236", encoding: "u2", access: "w" }
    }
    // Automatically changes occupancy to occupied when increased airflow
    // is detected: false (disabled), true (enabled)
    bv0 : BoolPoint? <notHaystack> {
      sp
      dis: "AutoOccMode"
      bacnetCurAddr: { addr: "BV0" }
      bacnetWriteAddr: { addr: "BV0" }
      modbusCurAddr: { addr: "000101", encoding: "bit" }
      modbusWriteAddr: { addr: "000101", encoding: "bit", access: "w" }
    }
    // Resetting the room occupancy mode from occupied to unoccupied in
    // the Control Point room panel
    msv5 : EnumPoint? <notHaystack> {
      sp
      dis: "PanelOccupancyReset"
      enum: Obj <val:OccupiedEnum>
      bacnetCurAddr: { addr: "MSV5" }
      bacnetWriteAddr: { addr: "MSV5" }
      modbusCurAddr: { addr: "400703", encoding: "u2" }
      modbusWriteAddr: { addr: "400703", encoding: "u2", access: "w" }
    }
    // Allows to invert the I1 input signal if required: false (normal),
    // true (invert)
    bv4 : BoolPoint? <notHaystack> {
      sp
      dis: "PresenceSensorInvert"
      bacnetCurAddr: { addr: "BV4" }
      bacnetWriteAddr: { addr: "BV4" }
      modbusCurAddr: { addr: "000105", encoding: "bit" }
      modbusWriteAddr: { addr: "000105", encoding: "bit", access: "w" }
    }
    // Allows to invert the I2 input signal if required: false (normal),
    // true (invert)
    bv5 : BoolPoint? <notHaystack> {
      sp
      dis: "WindowContactInvert"
      bacnetCurAddr: { addr: "BV5" }
      bacnetWriteAddr: { addr: "BV5" }
      modbusCurAddr: { addr: "000106", encoding: "bit" }
      modbusWriteAddr: { addr: "000106", encoding: "bit", access: "w" }
    }

    //////////////////////////////////////////////////////////////////
    // TemperatureSelector
    //////////////////////////////////////////////////////////////////

    // Calculated space temperature
    ai1 : ZoneAirTempSensor? {
      dis: "SpaceTemperature"
      bacnetCurAddr: { addr: "AI1" }
      modbusCurAddr: { addr: "300005", encoding: "u2" }
    }
    // Temperature sensor value from the network
    av10 : AirTempSensor? <notHaystack> {
      dis: "NetTemperature"
      bacnetCurAddr: { addr: "AV10" }
      bacnetWriteAddr: { addr: "AV10" }
      modbusCurAddr: { addr: "400211", encoding: "u2" }
      modbusWriteAddr: { addr: "400211", encoding: "u2", access: "w" }
    }
    // Actual temperature sensor value from the local U2 input
    ai3 : AirTempSensor? <notHaystack> {
      dis: "U2SpaceTemperature"
      bacnetCurAddr: { addr: "AI3" }
      modbusCurAddr: { addr: "300004", encoding: "u2" }
    }
    // Actual temperature sensor value from the room panel
    ai4 : AirTempSensor? <notHaystack> {
      dis: "PanelTemperature"
      bacnetCurAddr: { addr: "AI4" }
      modbusCurAddr: { addr: "300301", encoding: "u2" }
    }
    // Calculated discharge temperature
    ai13 : DischargeAirTempSensor? {
      dis: "DischargeTemperature"
      bacnetCurAddr: { addr: "AI13" }
      modbusCurAddr: { addr: "300014", encoding: "u2" }
    }
    // Discharge temperature sensor value from the network
    av18 : AirTempSensor? <notHaystack> {
      dis: "NetDuctInTemp"
      bacnetCurAddr: { addr: "AV18" }
      bacnetWriteAddr: { addr: "AV18" }
      modbusCurAddr: { addr: "400219", encoding: "u2" }
      modbusWriteAddr: { addr: "400219", encoding: "u2", access: "w" }
    }
    // Actual discharge temperature sensor value comes from the U1 input
    ai16 : AirTempSensor? <notHaystack> {
      dis: "U1DischTemperature"
      bacnetCurAddr: { addr: "AI16" }
      modbusCurAddr: { addr: "300017", encoding: "u2" }
    }
    // Allows to select the space temperature type
    msv22 : EnumPoint? <notHaystack> {
      sp
      dis: "U2SpaceTempType"
      enum: Obj <val:TempSensorTypeEnum>
      bacnetCurAddr: { addr: "MSV22" }
      bacnetWriteAddr: { addr: "MSV22" }
      modbusCurAddr: { addr: "400283", encoding: "u2" }
      modbusWriteAddr: { addr: "400283", encoding: "u2", access: "w" }
    }
    // Allows to select the discharge temperature type
    msv21 : EnumPoint? <notHaystack> {
      sp
      dis: "U1DischargeTempType"
      enum: Obj <val:TempSensorTypeEnum>
      bacnetCurAddr: { addr: "MSV21" }
      bacnetWriteAddr: { addr: "MSV21" }
      modbusCurAddr: { addr: "400282", encoding: "u2" }
      modbusWriteAddr: { addr: "400282", encoding: "u2", access: "w" }
    }
    // Allows to choose the temperature source for control logic
    msv23 : EnumPoint? <notHaystack> {
      sp
      dis: "TemperatureInputSelector"
      enum: Obj <val:TemperatureInputSelectorEnum>
      bacnetCurAddr: { addr: "MSV23" }
      bacnetWriteAddr: { addr: "MSV23" }
      modbusCurAddr: { addr: "400284", encoding: "u2" }
      modbusWriteAddr: { addr: "400284", encoding: "u2", access: "w" }
    }

    //////////////////////////////////////////////////////////////////
    // OffsetCalculator
    //////////////////////////////////////////////////////////////////

    // Temperature offset for setpoint from the room panel
    av58 : AirTempSensor? <notHaystack> {
      delta
      dis: "OffsetTempSetpoint"
      bacnetCurAddr: { addr: "AV58" }
      bacnetWriteAddr: { addr: "AV58" }
      modbusCurAddr: { addr: "400504", encoding: "u2" }
      modbusWriteAddr: { addr: "400504", encoding: "u2", access: "w" }
    }
    // Sets the setpoint offset range to be changed by the user (e.g., a
    // value of 5 means a range from -5 to +5), (min = 0, max = 10)
    av37 : AirTempSp? <notHaystack> {
      delta
      dis: "SetpointOffsetRange"
      bacnetCurAddr: { addr: "AV37" }
      bacnetWriteAddr: { addr: "AV37" }
      modbusCurAddr: { addr: "400238", encoding: "u2" }
      modbusWriteAddr: { addr: "400238", encoding: "u2", access: "w" }
    }
    // Actual setpoint offset value (calculated from resistance) from the
    // U3 input
    ai17 : AirTempSensor? <notHaystack> {
      delta
      dis: "U3SetpointOffset"
      bacnetCurAddr: { addr: "AI17" }
      modbusCurAddr: { addr: "300018", encoding: "u2" }
    }
    // Allows to select which value to be displayed during the offset
    // editing according to the set Panel Setpoint Mode: false (offset),
    // true (setpoint)
    bo56 : BoolPoint? <notHaystack> {
      sp
      dis: "PanelSetpointDisplay"
      bacnetCurAddr: { addr: "BO56" }
      bacnetWriteAddr: { addr: "BO56" }
      modbusCurAddr: { addr: "000157", encoding: "bit" }
      modbusWriteAddr: { addr: "000157", encoding: "bit", access: "w" }
    }
    // Offset temperature setpoint value from the network
    av41 : AirTempSp? <notHaystack> {
      delta
      dis: "NetOffsetSetpoint"
      bacnetCurAddr: { addr: "AV41" }
      bacnetWriteAddr: { addr: "AV41" }
      modbusCurAddr: { addr: "400242", encoding: "u2" }
      modbusWriteAddr: { addr: "400242", encoding: "u2", access: "w" }
    }
    // Allows to choose the setpoint offset source for control logic
    msv24 : EnumPoint? <notHaystack> {
      sp
      dis: "SetpointOffsetSelector"
      enum: Obj <val:SetpointOffsetSelectorEnum>
      bacnetCurAddr: { addr: "MSV24" }
      bacnetWriteAddr: { addr: "MSV24" }
      modbusCurAddr: { addr: "400285", encoding: "u2" }
      modbusWriteAddr: { addr: "400285", encoding: "u2", access: "w" }
    }

    //////////////////////////////////////////////////////////////////
    // TemperatureSetpointSelector
    //////////////////////////////////////////////////////////////////

    // Sets the temperature setpoint mode in the Control Point room panel
    // - directly or as an offset: false (offset), true (setpoint)
    bo55 : BoolPoint? <notHaystack> {
      sp
      dis: "PanelSetpointMode"
      bacnetCurAddr: { addr: "BO55" }
      bacnetWriteAddr: { addr: "BO55" }
      modbusCurAddr: { addr: "000156", encoding: "bit" }
      modbusWriteAddr: { addr: "000156", encoding: "bit", access: "w" }
    }
    // Temperature setpoint for cooling in the occupied state
    av0 : ZoneAirTempOccCoolingSp? {
      dis: "OccCoolTempSetpoint"
      bacnetCurAddr: { addr: "AV0" }
      bacnetWriteAddr: { addr: "AV0" }
      modbusCurAddr: { addr: "400201", encoding: "u2" }
      modbusWriteAddr: { addr: "400201", encoding: "u2", access: "w" }
    }
    // Temperature setpoint for heating in the occupied state
    av1 : ZoneAirTempOccHeatingSp? {
      dis: "OccHeatTempSetpoint"
      bacnetCurAddr: { addr: "AV1" }
      bacnetWriteAddr: { addr: "AV1" }
      modbusCurAddr: { addr: "400202", encoding: "u2" }
      modbusWriteAddr: { addr: "400202", encoding: "u2", access: "w" }
    }
    // Temperature setpoint for cooling in the standby state
    av2 : ZoneAirTempStandbyCoolingSp? {
      dis: "StandbyCoolTempSetpoint"
      bacnetCurAddr: { addr: "AV2" }
      bacnetWriteAddr: { addr: "AV2" }
      modbusCurAddr: { addr: "400203", encoding: "u2" }
      modbusWriteAddr: { addr: "400203", encoding: "u2", access: "w" }
    }
    // Temperature setpoint for heating in the standby state
    av3 : ZoneAirTempStandbyHeatingSp? {
      dis: "StandbyHeatTempSetpoint"
      bacnetCurAddr: { addr: "AV3" }
      bacnetWriteAddr: { addr: "AV3" }
      modbusCurAddr: { addr: "400204", encoding: "u2" }
      modbusWriteAddr: { addr: "400204", encoding: "u2", access: "w" }
    }
    // Temperature setpoint for cooling in the unoccupied state
    av4 : ZoneAirTempUnoccCoolingSp? {
      dis: "UnoccCoolTempSetpoint"
      bacnetCurAddr: { addr: "AV4" }
      bacnetWriteAddr: { addr: "AV4" }
      modbusCurAddr: { addr: "400205", encoding: "u2" }
      modbusWriteAddr: { addr: "400205", encoding: "u2", access: "w" }
    }
    // Temperature setpoint for heating in the unoccupied state
    av5 : ZoneAirTempUnoccHeatingSp? {
      dis: "UnoccHeatTempSetpoint"
      bacnetCurAddr: { addr: "AV5" }
      bacnetWriteAddr: { addr: "AV5" }
      modbusCurAddr: { addr: "400206", encoding: "u2" }
      modbusWriteAddr: { addr: "400206", encoding: "u2", access: "w" }
    }
    // Calculated effective temperature setpoint based on occupancy
    // status and heating or cooling temperature setpoints (depending on
    // demand)
    ai9 : ZoneAirTempEffectiveSp? {
      dis: "EffectiveTempSetpoint"
      bacnetCurAddr: { addr: "AI9" }
      modbusCurAddr: { addr: "300010", encoding: "u2" }
    }
    // Calculated Central Temperature Setpoint based on setpoints and
    // occupancy status
    ai10 : AirTempSp? <notHaystack> {
      dis: "CentralTempSetpoint"
      bacnetCurAddr: { addr: "AI10" }
      modbusCurAddr: { addr: "300011", encoding: "u2" }
    }
    // Temperature setpoint from the room panel
    av56 : AirTempSp? <notHaystack> {
      dis: "PanelTempSetpoint"
      bacnetCurAddr: { addr: "AV56" }
      bacnetWriteAddr: { addr: "AV56" }
      modbusCurAddr: { addr: "400502", encoding: "u2" }
      modbusWriteAddr: { addr: "400502", encoding: "u2", access: "w" }
    }
    // High limit of discharge temperature supplied to the room
    av7 : AirTempSp? {
      dis: "MaxDischTempSetpoint"
      bacnetCurAddr: { addr: "AV7" }
      bacnetWriteAddr: { addr: "AV7" }
      modbusCurAddr: { addr: "400208", encoding: "u2" }
      modbusWriteAddr: { addr: "400208", encoding: "u2", access: "w" }
    }
    // Calculated discharge temperature setpoint based on the effective
    // temperature setpoint and heating demand for high-limiting
    // discharge temperature
    ai14 : AirTempSp? <notHaystack> {
      dis: "ActDischTempSetpoint"
      bacnetCurAddr: { addr: "AI14" }
      modbusCurAddr: { addr: "300015", encoding: "u2" }
    }
    // Low limit of discharge temperature supplied to the room
    av8 : AirTempSp? {
      dis: "MinDischTempSetpoint"
      bacnetCurAddr: { addr: "AV8" }
      bacnetWriteAddr: { addr: "AV8" }
      modbusCurAddr: { addr: "400209", encoding: "u2" }
      modbusWriteAddr: { addr: "400209", encoding: "u2", access: "w" }
    }

    //////////////////////////////////////////////////////////////////
    // CO2Selector
    //////////////////////////////////////////////////////////////////

    // Actual CO2 sensor value from the room panel
    ai6 : Co2Sensor? <notHaystack> {
      dis: "PanelCO2"
      bacnetCurAddr: { addr: "AI6" }
      modbusCurAddr: { addr: "300303", encoding: "u2" }
    }
    // CO2 sensor value comes from the network
    av40 : Co2Sensor? <notHaystack> {
      dis: "NetCO2"
      bacnetCurAddr: { addr: "AV40" }
      bacnetWriteAddr: { addr: "AV40" }
      modbusCurAddr: { addr: "400241", encoding: "u2" }
      modbusWriteAddr: { addr: "400241", encoding: "u2", access: "w" }
    }
    // Actual CO2 sensor value from the local U4 input
    ai8 : Co2Sensor? <notHaystack> {
      dis: "U4CO2Sensor"
      bacnetCurAddr: { addr: "AI8" }
      modbusCurAddr: { addr: "300009", encoding: "u2" }
    }
    // Calculated space CO2
    ai5 : ZoneCo2Sensor? {
      dis: "SpaceCO2"
      bacnetCurAddr: { addr: "AI5" }
      modbusCurAddr: { addr: "300006", encoding: "u2" }
    }
    // Sets the range of the CO2 sensor used (min = 0, max = 10000)
    av38 : NumberPoint? <notHaystack> {
      sp
      dis: "U4CO2SensorRange"
      bacnetCurAddr: { addr: "AV38" }
      bacnetWriteAddr: { addr: "AV38" }
      modbusCurAddr: { addr: "400239", encoding: "u2" }
      modbusWriteAddr: { addr: "400239", encoding: "u2", access: "w" }
    }
    // Allows to select the CO2 source for control logic
    msv25 : EnumPoint? <notHaystack> {
      sp
      dis: "CO2InputSelector"
      enum: Obj <val:Co2InputSelectorEnum>
      bacnetCurAddr: { addr: "MSV25" }
      bacnetWriteAddr: { addr: "MSV25" }
      modbusCurAddr: { addr: "400286", encoding: "u2" }
      modbusWriteAddr: { addr: "400286", encoding: "u2", access: "w" }
    }

    //////////////////////////////////////////////////////////////////
    // AirflowCalculator
    //////////////////////////////////////////////////////////////////

    // Sets the K-Factor (the flow rate at a differential pressure of 1
    // inWC/1 Pa on the measuring cross) for the given VAV model (min = 0)
    av61 : NumberPoint? <notHaystack> {
      sp
      dis: "K-Factor"
      bacnetCurAddr: { addr: "AV61" }
      bacnetWriteAddr: { addr: "AV61" }
      modbusCurAddr: { addr: "400289", encoding: "u2" }
      modbusWriteAddr: { addr: "400289", encoding: "u2", access: "w" }
    }
    // Actual differential pressure sensor-measured value from the
    // built-in pressure input
    ai15 : AirPressureSensor? <notHaystack> {
      delta
      dis: "DifferentialPressure"
      bacnetCurAddr: { addr: "AI15" }
      modbusCurAddr: { addr: "300016", encoding: "u2" }
    }
    // Actual calculated airflow based on the K-Factor value and
    // differential pressure measure
    ai11 : DischargeAirFlowSensor? {
      dis: "ActualAirFlow"
      bacnetCurAddr: { addr: "AI11" }
      modbusCurAddr: { addr: "300012", encoding: "u2" }
    }
    // Allows to enter the airflow value measured by the hood for
    // calibration
    av66 : NumberPoint? <notHaystack> {
      sp
      dis: "AirflowCalibration"
      bacnetCurAddr: { addr: "AV66" }
      bacnetWriteAddr: { addr: "AV66" }
      modbusCurAddr: { addr: "400294", encoding: "u2" }
      modbusWriteAddr: { addr: "400294", encoding: "u2", access: "w" }
    }
    // Calculated K-Factor value (meaning the flow rate at a differential
    // pressure of 1 inWC/1 Pa on the measuring cross) based on the
    // entered measured airflow (using the hood) and the measured
    // differential pressure from the built-in PI input
    av62 : NumberPoint? <notHaystack> {
      sensor
      dis: "CalculatedKFactor"
      bacnetCurAddr: { addr: "AV62" }
      bacnetWriteAddr: { addr: "AV62" }
      modbusCurAddr: { addr: "400290", encoding: "u2" }
      modbusWriteAddr: { addr: "400290", encoding: "u2", access: "w" }
    }
    // Allows to perform zeroing action on the built-in PI pressure
    // transducer if there is a non-zero value in the absence of airflow.
    // Important: perform in the absence of airflow through the pressure
    // transducer ports: false (no), true (zeroing)
    bv13 : BoolPoint? <notHaystack> {
      cmd
      dis: "PressureZeroing"
      bacnetCurAddr: { addr: "BV13" }
      bacnetWriteAddr: { addr: "BV13" }
      modbusCurAddr: { addr: "000114", encoding: "bit" }
      modbusWriteAddr: { addr: "000114", encoding: "bit", access: "w" }
    }

    //////////////////////////////////////////////////////////////////
    // AirflowSetpointCalculator
    //////////////////////////////////////////////////////////////////

    // Calculated effective airflow setpoint based on the occupancy
    // status and heating or cooling airflow setpoints
    ai12 : DischargeAirFlowSp? {
      dis: "EffectiveAirFlowSetpoint"
      bacnetCurAddr: { addr: "AI12" }
      modbusCurAddr: { addr: "300013", encoding: "u2" }
    }
    // Current HVAC status
    msi1 : EnumPoint? <notHaystack> {
      sensor
      dis: "HVACStatus"
      enum: Obj <val:HvacStatusEnum>
      bacnetCurAddr: { addr: "MSI1" }
